{
  "sdkVersion": "0.0.109",
  "tools": [
    {
      "name": "search_questions",
      "displayName": "Search Questions",
      "description": "Search for questions on Quora by keyword. Returns a list of matching questions with snippets and URLs.",
      "icon": "search",
      "group": "Discovery",
      "input_schema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1,
            "description": "Search keyword or phrase"
          },
          "limit": {
            "description": "Maximum results to return (default 10)",
            "type": "integer",
            "minimum": 1,
            "maximum": 50
          },
          "type": {
            "description": "Content type to search — questions, answers, or all (default: question)",
            "type": "string",
            "enum": [
              "question",
              "answer",
              "all"
            ]
          }
        },
        "required": [
          "query"
        ],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "results": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "title": {
                  "type": "string",
                  "description": "Question title or result headline"
                },
                "url": {
                  "type": "string",
                  "description": "Full URL to the result"
                },
                "snippet": {
                  "description": "Text snippet preview",
                  "type": "string"
                },
                "answerCount": {
                  "description": "Number of answers (if available)",
                  "type": "number"
                },
                "topic": {
                  "description": "Topic name if applicable",
                  "type": "string"
                }
              },
              "required": [
                "title",
                "url"
              ],
              "additionalProperties": false
            }
          },
          "total": {
            "type": "number",
            "description": "Total number of results returned"
          }
        },
        "required": [
          "results",
          "total"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "get_feed",
      "displayName": "Get Feed",
      "description": "Get the user's main Quora feed — questions and stories from topics/users the user follows. Returns feed items with titles, previews, and URLs.",
      "icon": "layout-list",
      "group": "Discovery",
      "input_schema": {
        "type": "object",
        "properties": {
          "limit": {
            "description": "Maximum feed items to return (default 10)",
            "type": "integer",
            "minimum": 1,
            "maximum": 50
          }
        },
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "description": "Feed item ID"
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "question",
                    "answer",
                    "ad",
                    "unknown"
                  ],
                  "description": "Content type"
                },
                "title": {
                  "description": "Question title or story headline",
                  "type": "string"
                },
                "preview": {
                  "description": "Text preview snippet",
                  "type": "string"
                },
                "url": {
                  "description": "URL to the content",
                  "type": "string"
                },
                "author": {
                  "description": "Author name if applicable",
                  "type": "string"
                }
              },
              "required": [
                "id",
                "type"
              ],
              "additionalProperties": false
            }
          },
          "total": {
            "type": "number",
            "description": "Total items returned"
          }
        },
        "required": [
          "items",
          "total"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "get_question_details",
      "displayName": "Get Question Details",
      "description": "Get metadata for the current Quora question page — title, answer count, follower count, topics. Useful for understanding context before answering.",
      "icon": "info",
      "group": "Reading",
      "input_schema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "found": {
            "type": "boolean",
            "description": "Whether a question was detected on the page"
          },
          "title": {
            "description": "The question title",
            "type": "string"
          },
          "url": {
            "description": "Question URL",
            "type": "string"
          },
          "answer_count": {
            "description": "Number of answers",
            "type": "number"
          },
          "follower_count": {
            "description": "Number of followers",
            "type": "number"
          },
          "topic": {
            "description": "Primary topic if detectable",
            "type": "string"
          },
          "page_title": {
            "type": "string",
            "description": "Browser page title"
          },
          "current_url": {
            "type": "string",
            "description": "Current page URL"
          }
        },
        "required": [
          "found",
          "page_title",
          "current_url"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "get_question_answers",
      "displayName": "Get Question Answers",
      "description": "Get answers for a Quora question. Provide a question URL or the tool will read answers from the currently open question page. Returns answers with author, content preview, and upvote counts.",
      "icon": "messages-square",
      "group": "Reading",
      "input_schema": {
        "type": "object",
        "properties": {
          "question_url": {
            "description": "Full URL to the Quora question (e.g., https://www.quora.com/What-is-X). Leave empty to use the current page.",
            "type": "string",
            "format": "uri"
          },
          "limit": {
            "description": "Maximum answers to return (default 10)",
            "type": "integer",
            "minimum": 1,
            "maximum": 50
          },
          "sort": {
            "description": "Sort order for answers",
            "type": "string",
            "enum": [
              "default",
              "recent",
              "upvotes"
            ]
          }
        },
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "question": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "url": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "title",
              "url"
            ],
            "additionalProperties": false
          },
          "answers": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "author": {
                  "type": "string"
                },
                "author_url": {
                  "type": "string"
                },
                "content": {
                  "type": "string"
                },
                "upvote_count": {
                  "type": "number"
                },
                "timestamp": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "author",
                "content",
                "upvote_count"
              ],
              "additionalProperties": false
            }
          },
          "total": {
            "type": "number"
          }
        },
        "required": [
          "question",
          "answers",
          "total"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "post_answer",
      "displayName": "Post Answer",
      "description": "Write and submit an answer to a Quora question. Navigate to the question page first, or provide a question URL. Supports rich text content.",
      "icon": "pen-square",
      "group": "Writing",
      "input_schema": {
        "type": "object",
        "properties": {
