{
  "name": "opentabs-plugin-quora",
  "version": "1.0.0",
  "description": "OpenTabs plugin for Quora — search, read, write, and interact with everything on Quora",
  "keywords": ["opentabs-plugin"],
  "main": "dist/adapter.iife.js",
  "type": "module",
  "opentabs": {
    "displayName": "Quora",
    "description": "OpenTabs plugin for Quora — browse questions, read/write answers, upvote, follow, comment, and more",
    "urlPatterns": ["*://*.quora.com/*"]
  },
  "scripts": {
    "build": "tsc && opentabs-plugin build",
    "dev": "tsc --watch & opentabs-plugin build --watch",
    "inspect": "opentabs-plugin inspect",
    "readme": "opentabs-plugin readme"
  },
  "devDependencies": {
    "@opentabs-dev/plugin-tools": "^0.0.109",
    "@opentabs-dev/plugin-sdk": "^0.0.109",
    "typescript": "^5.7.0",
    "zod": "^4.0.0"
  }
}
